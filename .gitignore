.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/
.env
*.log

# Large datasets and generated model files
data/raw/*
data/processed/*
models/*
outputs/*

# Keep folder structures
!data/raw/.gitkeep
!data/processed/.gitkeep
!models/.gitkeep
!outputs/.gitkeep

# Ignore datasets and generated artifacts in all applications
**/data/raw/*
**/data/processed/*
**/models/*
**/outputs/*

# Keep directory placeholders
!**/data/raw/.gitkeep
!**/data/processed/.gitkeep
!**/models/.gitkeep
!**/outputs/.gitkeep
